<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".fhir.FhirApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Surveillance"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".auth.InitialSyncActivity"
            android:exported="false"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".cases.GeneralEditorActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".auth.ResetPasswordActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".auth.ForgotPasswordActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".ui.profile.SyncUploadActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />

        <service
            android:name=".services.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver android:name=".services.MarkReadReceiver" />

        <activity
            android:name=".auth.OneTimeSyncActivity"
            android:exported="false" />
        <activity
            android:name=".ui.notifications.NotificationActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".ui.patients.responses.EditChecklistActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".ui.patients.responses.ResponseQuestionnaireActivity"
            android:exported="false"
            android:label="Case Summary"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".clients.SyncActivity"
            android:exported="false"
            android:label="Data Sync"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".ui.patients.SummarizedActivity"
            android:exported="false"
            android:label="Case Summary "
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".cases.CaseListingActivity"
            android:exported="false"
            android:label="Case List"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".auth.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.FullScreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".clients.AddParentCaseActivity"
            android:exported="false"
            android:label="New Case"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".ui.patients.FullCaseDetailsActivity"
            android:exported="false"
            android:label="Case Summary "
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.patients.CaseDetailsActivity"
            android:exported="false"
            android:label="Case Details"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.patients.AddCaseActivity"
            android:exported="false"
            android:label="New Case"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
        <activity
            android:name=".ui.patients.ClientDetailsActivity"
            android:exported="false"
            android:label="Case Details"
            android:launchMode="singleTop" />
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.FullScreen"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Surveillance.NoActionBar" />
    </application>

</manifest>