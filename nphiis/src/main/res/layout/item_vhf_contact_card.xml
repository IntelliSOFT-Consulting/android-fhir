<?xml version="1.0" encoding="utf-8"?>
<!-- A contact in the case's Contacts tab: initials, name, EPID and follow-up status. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/home_card_background"
    app:cardElevation="0dp"
    app:strokeColor="@color/home_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/contact_initials"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_vhf_circle"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/contact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_card_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/contact_epid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/home_card_subtitle"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/contact_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_vhf_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/baseline_arrow_forward_ios_24"
            app:tint="@color/home_card_subtitle" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
