<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/montserratregular"
        android:gravity="center"
        android:text="@string/upload_options"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Upload Current Type -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCurrentTypeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratregular"
                android:text="@string/upload_current_resource_type"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentTypeDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserratregular"
                android:text="@string/upload_all_resources_of_the_selected_type_as_a_single_bundle"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- FIXED: Use standard Material 3 style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadCurrentType"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Upload Bundle" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Upload All Types -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratregular"
                android:text="@string/upload_all_resource_types"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAllTypesDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserratregular"
                android:text="@string/upload_all_pending_resources_from_all_types_as_a_single_bundle"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- FIXED: Use standard Material 3 style -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUploadAllTypes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/upload_all_bundles" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Close Button - Use TextButton style -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseSheet"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/close" />

</LinearLayout>