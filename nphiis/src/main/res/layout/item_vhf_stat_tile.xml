<?xml version="1.0" encoding="utf-8"?>
<!-- One figure in the VHF contact summary row: fixed height, label on one line (shrinks to fit). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="58dp"
    android:layout_margin="3dp"
    android:layout_weight="1"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/stat_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/stat_label"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/home_card_subtitle"
            android:textSize="11sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
