<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Surveillance" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_200</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
        <item name="android:fontFamily">@font/montserratregular</item>
        <item name="questionnaire_theme">@style/Theme.Surveillance.Questionnaire</item>
    </style>


    <style name="Theme.Surveillance.Questionnaire" parent="Theme.Questionnaire">
        <item name="questionnaireQuestionTextStyle">@style/Questionnaire.Surveillance.QuestionLabel</item>
        <item name="questionnaireEnhancedChoiceControls">true</item>
    </style>

    <style name="Questionnaire.Surveillance.QuestionLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Surveillance.QuestionLabel</item>
    </style>

    <style name="TextAppearance.Surveillance.QuestionLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Surveillance.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Questionnaire.LocationWidgetButtonStyle" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:drawableLeft">@drawable/baseline_add_location_24</item>
        <item name="android:drawableTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:text">@string/record_gps_location</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <style name="Theme.Surveillance.FullScreen">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="Theme.Surveillance.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Surveillance.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="BottomSheetDialogTheme" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_background</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.Surveillance" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="questionnaire_theme">@style/Theme.Surveillance.Questionnaire</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <string name="record_gps_location">Record GPS Location</string>

    <style name="LabelStyle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="ValueStyle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style
        name="TextAppearance.Surveillance.Toolbar.Title.Compact"
        parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:fontFamily">@font/intersemi</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <!-- Floating bottom nav labels: small, semi-bold, same size selected or not (no jump). -->
    <style name="TextAppearance.Surveillance.BottomNav" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/intersemi</item>
    </style>

    <!-- Patient summary tabs: sentence case, semi-bold, no all-caps. -->
    <style name="SummaryTabText" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="fontFamily">@font/montserratsemi</item>
        <item name="android:fontFamily">@font/montserratsemi</item>
    </style>

</resources>
