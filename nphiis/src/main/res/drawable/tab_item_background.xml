<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected tab -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/activeTabBackground" />
            <stroke android:width="2dp" android:color="@color/activeTabBorder" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Unselected tab -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/inactiveTabBackground" />
            <stroke android:width="1dp" android:color="@color/inactiveTabBorder" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
