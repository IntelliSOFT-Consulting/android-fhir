{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "title": "VHF Laboratory Results",
  "status": "draft",
  "item": [
    {
      "linkId": "vhf-lab-results",
      "text": "Laboratory Results",
      "type": "group",
      "item": [
        {
          "linkId": "vhf-received-date",
          "text": "Date sample received at the laboratory",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "linkId": "vhf-sample-condition",
          "text": "Condition of sample",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "good",
                "display": "Good"
              }
            },
            {
              "valueCoding": {
                "code": "spoiled",
                "display": "Spoiled"
              }
            }
          ]
        },
        {
          "linkId": "vhf-lab-tests",
          "text": "Laboratory tests performed (tick all that apply)",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "check-box",
                    "display": "Check-box"
                  }
                ]
              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "pcr",
                "display": "PCR"
              }
            },
            {
              "valueCoding": {
                "code": "elisa",
                "display": "ELISA"
              }
            },
            {
              "valueCoding": {
                "code": "antigen-rdt",
                "display": "Antigen rapid test"
              }
            },
            {
              "valueCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ],
          "repeats": true
        },
        {
          "linkId": "vhf-lab-tests-other",
          "text": "Other (specify)",
          "type": "string",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-lab-tests",
              "operator": "=",
              "answerCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ]
        },
        {
          "linkId": "vhf-preliminary-result",
          "text": "Preliminary result",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "positive",
                "display": "Positive"
              }
            },
            {
              "valueCoding": {
                "code": "negative",
                "display": "Negative"
              }
            },
            {
              "valueCoding": {
                "code": "pending",
                "display": "Pending"
              }
            }
          ]
        },
        {
          "linkId": "vhf-preliminary-result-date",
          "text": "Date of preliminary result",
          "type": "date",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-preliminary-result",
              "operator": "=",
              "answerCoding": {
                "code": "positive",
                "display": "Positive"
              }
            },
            {
              "question": "vhf-preliminary-result",
              "operator": "=",
              "answerCoding": {
                "code": "negative",
                "display": "Negative"
              }
            }
          ],
          "enableBehavior": "any",
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
              "extension": [
                {
                  "url": "key",
                  "valueId": "vhf-preliminary-result-date-after"
                },
                {
                  "url": "requirements",
                  "valueString": "Date of preliminary result cannot be before the date the sample was received"
                },
                {
                  "url": "severity",
                  "valueCode": "error"
                },
                {
                  "url": "expression",
                  "valueString": "%context.answer.value >= %resource.descendants().where(linkId='vhf-received-date').answer.value"
                },
                {
                  "url": "human",
                  "valueString": "Date of preliminary result cannot be before the date the sample was received"
                },
                {
                  "url": "location",
                  "valueString": "vhf-received-date"
                }
              ]
            }
          ]
        },
        {
          "linkId": "vhf-preliminary-narration",
          "text": "Narration (preliminary)",
          "type": "text"
        },
        {
          "linkId": "vhf-preliminary-lab",
          "text": "Preliminary laboratory facility",
          "type": "string"
        },
        {
          "linkId": "vhf-final-result",
          "text": "Final result",
          "type": "choice",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "positive",
                "display": "Positive"
              }
            },
            {
              "valueCoding": {
                "code": "negative",
                "display": "Negative"
              }
            }
          ]
        },
        {
          "linkId": "vhf-final-result-date",
          "text": "Date of final result",
          "type": "date",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-final-result",
              "operator": "exists",
              "answerBoolean": true
            }
          ],
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-constraint",
              "extension": [
                {
                  "url": "key",
                  "valueId": "vhf-final-result-date-after"
                },
                {
                  "url": "requirements",
                  "valueString": "Date of final result cannot be before the date the sample was received"
                },
                {
                  "url": "severity",
                  "valueCode": "error"
                },
                {
                  "url": "expression",
                  "valueString": "%context.answer.value >= %resource.descendants().where(linkId='vhf-received-date').answer.value"
                },
                {
                  "url": "human",
                  "valueString": "Date of final result cannot be before the date the sample was received"
                },
                {
                  "url": "location",
                  "valueString": "vhf-received-date"
                }
              ]
            }
          ]
        },
        {
          "linkId": "vhf-final-narration",
          "text": "Narration (final)",
          "type": "text"
        },
        {
          "linkId": "vhf-final-lab",
          "text": "Final laboratory facility",
          "type": "string"
        },
        {
          "linkId": "vhf-final-classification",
          "text": "Final classification",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "confirmed",
                "display": "Confirmed"
              }
            },
            {
              "valueCoding": {
                "code": "probable",
                "display": "Probable"
              }
            },
            {
              "valueCoding": {
                "code": "not-a-case",
                "display": "Not a case"
              }
            }
          ]
        }
      ]
    }
  ]
}