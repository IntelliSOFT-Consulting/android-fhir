                    "display": "Check-box"
                  }
                ]
              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "not-found",
                "display": "Contact not found"
              }
            },
            {
              "valueCoding": {
                "code": "unreachable",
                "display": "Contact not reachable by phone"
              }
            },
            {
              "valueCoding": {
                "code": "refused",
                "display": "Refused follow up"
              }
            },
            {
              "valueCoding": {
                "code": "relocated",
                "display": "Relocated"
              }
            },
            {
              "valueCoding": {
                "code": "access",
                "display": "Insecurity / poor access"
              }
            },
            {
              "valueCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ],
          "repeats": true
        },
        {
          "linkId": "vhf-follow-up-challenges-other",
          "text": "Follow up challenges (other)",
          "type": "string",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-follow-up-challenges",
