{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "title": "VHF Contact Follow Up",
  "status": "draft",
  "item": [
    {
      "linkId": "vhf-contact-follow-up",
      "text": "Contact Follow Up",
      "type": "group",
      "item": [
        {
          "linkId": "vhf-follow-up-day",
          "text": "Day of follow up",
          "type": "integer",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueInteger": 21
            },
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Must be between 0 and 21"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "e.g. 1 for day one, 2 for day two"
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-date",
          "text": "Date of follow up",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-contact-status",
          "text": "Contact status today",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "alive",
                "display": "Alive"
              }
            },
            {
              "valueCoding": {
                "code": "died",
                "display": "Died"
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-death-date",
          "text": "Date of death",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ],
          "enableWhen": [
            {
              "question": "vhf-follow-up-contact-status",
              "operator": "=",
              "answerCoding": {
                "code": "died",
                "display": "Died"
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-mark-x-died",
          "type": "display",
          "text": "Mark X: the contact has died. Complete the Case Report Form and record the monitoring status as Died.",
          "enableWhen": [
            {
              "question": "vhf-follow-up-contact-status",
              "operator": "=",
              "answerCoding": {
                "code": "died",
                "display": "Died"
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-symptomatic",
          "text": "Symptomatic?",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "yes",
                "display": "Yes"
              }
            },
            {
              "valueCoding": {
                "code": "no",
                "display": "No"
              }
            }
          ],
          "enableWhen": [
            {
              "question": "vhf-follow-up-contact-status",
              "operator": "=",
              "answerCoding": {
                "code": "alive",
                "display": "Alive"
              }
            },
            {
              "question": "vhf-follow-up-contact-status",
              "operator": "exists",
              "answerBoolean": false
            }
          ],
          "enableBehavior": "any"
        },
        {
          "linkId": "vhf-follow-up-symptoms",
          "text": "Symptoms (tick all that apply)",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "check-box",
                    "display": "Check-box"
                  }
                ]
              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "fever",
                "display": "Fever"
              }
            },
            {
              "valueCoding": {
                "code": "malaise",
                "display": "Malaise"
              }
            },
            {
              "valueCoding": {
                "code": "muscle-pain",
                "display": "Muscle pain"
              }
            },
            {
              "valueCoding": {
                "code": "headache",
                "display": "Headache"
              }
            },
            {
              "valueCoding": {
                "code": "fatigue",
                "display": "Weakness/Fatigue"
              }
            },
            {
              "valueCoding": {
                "code": "sore-throat",
                "display": "Sore throat"
              }
            },
            {
              "valueCoding": {
                "code": "vomiting",
                "display": "Vomiting"
              }
            },
            {
              "valueCoding": {
                "code": "diarrhea",
                "display": "Diarrhoea"
              }
            },
            {
              "valueCoding": {
                "code": "rash",
                "display": "Rash"
              }
            },
            {
              "valueCoding": {
                "code": "unexplained-bleeding",
                "display": "Hemorrhage"
              }
            },
            {
              "valueCoding": {
                "code": "hiccups",
                "display": "Hiccups"
              }
            },
            {
              "valueCoding": {
                "code": "other",
                "display": "Others (specify, e.g. chills)"
              }
            },
            {
              "valueCoding": {
                "code": "none",
                "display": "None"
              },
              "extension": [
                {
                  "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-optionExclusive",
                  "valueBoolean": true
                }
              ]
            }
          ],
          "repeats": true,
          "enableWhen": [
            {
              "question": "vhf-follow-up-symptomatic",
              "operator": "=",
              "answerCoding": {
                "code": "yes",
                "display": "Yes"
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-bleeding-site",
          "text": "Hemorrhage (specify site)",
          "type": "string",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-follow-up-symptoms",
              "operator": "=",
              "answerCoding": {
                "code": "unexplained-bleeding",
                "display": "Hemorrhage"
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-symptoms-other",
          "text": "Other symptoms (specify)",
          "type": "string",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-follow-up-symptoms",
              "operator": "=",
              "answerCoding": {
                "code": "other",
                "display": "Others (specify, e.g. chills)"
              }
            }
          ]
        },
        {
