  "extension": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "followUpCounty",
        "language": "text/fhirpath",
        "expression": "%resource.descendants().where(linkId='vhf-follow-up-county-location').answer.value.reference"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
