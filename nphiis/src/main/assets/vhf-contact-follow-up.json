              "operator": "=",
              "answerCoding": {
                "code": "yes",
                "display": "Yes"
              }
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-tracer-name",
          "text": "Volunteer / CHP name",
          "type": "string",
          "required": true
        },
        {
          "linkId": "vhf-follow-up-tracer-phone",
          "text": "Volunteer / CHP mobile number",
          "type": "string",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "phone-number",
                    "display": "Phone Number"
                  }
                ]
              }
            },
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Enter a valid phone number, 10 to 13 characters: 07xxxxxxxx, or with the country code, e.g. +254 or +256"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "^(0\\d{9}|\\+[1-9]\\d{8,11}|[1-9]\\d{9,11})$"
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-tracer-email",
          "text": "Volunteer / CHP email address",
          "type": "string",
          "required": false,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Enter a valid email address"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            }
          ]
        },
        {
          "linkId": "vhf-follow-up-approach",
          "text": "Follow up approach",
          "type": "choice",
          "required": true,
          "extension": [
            {
