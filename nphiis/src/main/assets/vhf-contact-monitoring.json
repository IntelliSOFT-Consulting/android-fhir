{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "title": "VHF Contact Monitoring",
  "status": "draft",
  "item": [
    {
      "linkId": "vhf-contact-monitoring",
      "text": "Contact Monitoring",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "page",
                "display": "Page"
              }
            ]
          }
        }
      ],
      "item": [
        {
          "linkId": "vhf-exposure-risk",
          "text": "Exposure risk",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "high",
                "display": "High"
              }
            },
            {
              "valueCoding": {
                "code": "low",
                "display": "Low"
              }
            }
          ]
        },
        {
          "linkId": "vhf-monitoring-status",
          "text": "Current monitoring status",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "under-follow-up",
                "display": "Under follow up"
              }
            },
            {
              "valueCoding": {
                "code": "completed",
                "display": "Completed follow up (released)"
              }
            },
            {
              "valueCoding": {
                "code": "became-case",
                "display": "Became a suspected case"
              }
            },
            {
              "valueCoding": {
                "code": "lost",
                "display": "Lost to follow up"
              }
            },
            {
              "valueCoding": {
                "code": "died",
                "display": "Died"
              }
            }
          ]
        },
        {
          "linkId": "vhf-missed-follow-up-days",
          "text": "Missed follow-up days",
          "type": "integer",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueInteger": 21
            },
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Must be between 0 and 21"
            }
          ]
        },
        {
          "linkId": "vhf-final-outcome-date",
          "text": "Date of final outcome",
          "type": "date",
          "enableWhen": [
            {
              "question": "vhf-monitoring-status",
              "operator": "!=",
              "answerCoding": {
                "code": "under-follow-up",
                "display": "Under follow up"
              }
            }
          ],
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "linkId": "vhf-monitoring-remarks",
          "text": "Remarks",
          "type": "text"
        }
      ]
    },
    {
      "linkId": "vhf-official",
      "text": "Official",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "page",
                "display": "Page"
              }
            ]
          }
        }
      ],
      "item": [
        {
          "linkId": "vhf-checked-by-name",
          "text": "Checked by (name)",
          "type": "string",
          "required": true
        },
        {
          "linkId": "vhf-checked-by-email",
          "text": "Checked by (email address)",
          "type": "string",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Enter a valid email address"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            }
          ]
        },
        {
          "linkId": "vhf-date-checked",
          "text": "Date checked",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}