{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "title": "VHF Case Outcome",
  "status": "draft",
  "item": [
    {
      "linkId": "vhf-case-outcome",
      "type": "group",
      "text": "Case Outcome",
      "item": [
        {
          "linkId": "vhf-outcome",
          "text": "Outcome of case",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "alive",
                "display": "Alive"
              }
            },
            {
              "valueCoding": {
                "code": "dead",
                "display": "Dead"
              }
            }
          ]
        },
        {
          "linkId": "vhf-death-date",
          "text": "Date of death",
          "type": "date",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-outcome",
              "operator": "=",
              "answerCoding": {
                "code": "dead",
                "display": "Dead"
              }
            }
          ],
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "linkId": "vhf-death-place",
          "text": "Place of death",
          "type": "choice",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-outcome",
              "operator": "=",
              "answerCoding": {
                "code": "dead",
                "display": "Dead"
              }
            }
          ],
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "community",
                "display": "Community"
              }
            },
            {
              "valueCoding": {
                "code": "health-facility",
                "display": "Health facility"
              }
            },
            {
              "valueCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ]
        },
        {
          "linkId": "vhf-death-place-other",
          "text": "Other (specify)",
          "type": "string",
          "required": true,
          "enableWhen": [
            {
              "question": "vhf-death-place",
              "operator": "=",
              "answerCoding": {
                "code": "other",
                "display": "Other (specify)"
              }
            }
          ]
        },
        {
          "linkId": "vhf-case-status",
          "text": "Status of case",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "active",
                "display": "Active"
              }
            },
            {
              "valueCoding": {
                "code": "recovered",
                "display": "Recovered"
              }
            },
            {
              "valueCoding": {
                "code": "dead",
                "display": "Dead"
              }
            }
          ]
        },
        {
          "linkId": "vhf-discharge-date",
          "text": "Date of discharge",
          "type": "date",
          "enableWhen": [
            {
              "question": "vhf-case-status",
              "operator": "=",
              "answerCoding": {
                "code": "recovered",
                "display": "Recovered"
              }
            }
          ],
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "vhf-official",
      "text": "Official",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "page",
                "display": "Page"
              }
            ]
          }
        }
      ],
      "item": [
        {
          "linkId": "vhf-checked-by-name",
          "text": "Checked by (name)",
          "type": "string",
          "required": true
        },
        {
          "linkId": "vhf-checked-by-email",
          "text": "Checked by (email address)",
          "type": "string",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Enter a valid email address"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            }
          ]
        },
        {
          "linkId": "vhf-date-checked",
          "text": "Date checked",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}