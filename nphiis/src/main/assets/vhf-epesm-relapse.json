{
  "resourceType": "Questionnaire",
  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "title": "VHF Survivor Relapse",
  "status": "draft",
  "item": [
    {
      "linkId": "epesm-relapse",
      "text": "Relapse / recurrence testing",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "page",
                "display": "Page"
              }
            ]
          }
        }
      ],
      "item": [
        {
          "linkId": "epesm-relapse-suspected",
          "text": "Is relapse suspected? (recurrence of fever or other symptoms)",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "yes",
                "display": "Yes"
              }
            },
            {
              "valueCoding": {
                "code": "no",
                "display": "No"
              }
            }
          ]
        },
        {
          "linkId": "epesm-relapse-pcr-date",
          "text": "Date of relapse confirmation PCR sample collection",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ],
          "enableWhen": [
            {
              "question": "epesm-relapse-suspected",
              "operator": "=",
              "answerCoding": {
                "code": "yes",
                "display": "Yes"
              }
            }
          ]
        },
        {
          "linkId": "epesm-relapse-pcr-result",
          "text": "Relapse confirmation PCR result",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "negative",
                "display": "Negative"
              }
            },
            {
              "valueCoding": {
                "code": "positive",
                "display": "Positive"
              }
            },
            {
              "valueCoding": {
                "code": "pending",
                "display": "Pending"
              }
            }
          ],
          "enableWhen": [
            {
              "question": "epesm-relapse-suspected",
              "operator": "=",
              "answerCoding": {
                "code": "yes",
                "display": "Yes"
              }
            }
          ]
        },
        {
          "linkId": "epesm-relapse-action",
          "text": "Action taken",
          "type": "choice",
          "required": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
              "valueCodeableConcept": {
                "coding": [
                  {
                    "system": "http://hl7.org/fhir/questionnaire-item-control",
                    "code": "radio-button",
                    "display": "Radio Button"
                  }
                ]
              }
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-choiceOrientation",
              "valueCode": "horizontal"
            }
          ],
          "answerOption": [
            {
              "valueCoding": {
                "code": "continue-observation",
                "display": "Continue observation"
              }
            },
            {
              "valueCoding": {
                "code": "readmit",
                "display": "Re-admit for isolation"
              }
            },
            {
              "valueCoding": {
                "code": "other",
                "display": "Other"
              }
            }
          ]
        },
        {
          "linkId": "epesm-relapse-action-other",
          "text": "Action taken (specify)",
          "type": "string",
          "required": true,
          "enableWhen": [
            {
              "question": "epesm-relapse-action",
              "operator": "=",
              "answerCoding": {
                "code": "other",
                "display": "Other"
              }
            }
          ]
        }
      ]
    },
    {
      "linkId": "vhf-official",
      "text": "Official",
      "type": "group",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-itemControl",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://hl7.org/fhir/questionnaire-item-control",
                "code": "page",
                "display": "Page"
              }
            ]
          }
        }
      ],
      "item": [
        {
          "linkId": "vhf-checked-by-name",
          "text": "Checked by (name)",
          "type": "string",
          "required": true
        },
        {
          "linkId": "vhf-checked-by-email",
          "text": "Checked by (email address)",
          "type": "string",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Enter a valid email address"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/regex",
              "valueString": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
            }
          ]
        },
        {
          "linkId": "vhf-date-checked",
          "text": "Date checked",
          "type": "date",
          "required": true,
          "extension": [
            {
              "url": "http://ehelse.no/fhir/StructureDefinition/validationtext",
              "valueString": "Cannot be a date in the future"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/entryFormat",
              "valueString": "yyyy-mm-dd"
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueDate": {
                "extension": [
                  {
                    "url": "http://hl7.org/fhir/StructureDefinition/cqf-calculatedValue",
                    "valueExpression": {
                      "language": "text/fhirpath",
                      "expression": "today()"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
